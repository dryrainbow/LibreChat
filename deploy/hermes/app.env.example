# Private runtime/app.env on Pi. Fill locally; never commit working credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=3080
DOMAIN_CLIENT=https://YOUR_DOMAIN
DOMAIN_SERVER=https://YOUR_DOMAIN
TRUST_PROXY=1
SESSION_COOKIE_SECURE=true
# URI targets FerretDB's fixed IP in a private Docker network, with no published host port.
MONGO_URI=REPLACE_WITH_PRIVATE_DATABASE_URI
HERMES_API_KEY=REPLACE_WITH_PI_HERMES_API_SERVER_KEY
JWT_SECRET=REPLACE_WITH_RANDOM_48_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_48_BYTE_HEX
CREDS_KEY=REPLACE_WITH_RANDOM_32_BYTE_HEX
CREDS_IV=REPLACE_WITH_RANDOM_16_BYTE_HEX
ENDPOINTS=custom
CONFIG_PATH=/app/librechat.yaml
SEARCH=false
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=false
DEBUG_LOGGING=false
DEBUG_CONSOLE=false
AGENT_DEBUG_LOGGING=false
LOG_TO_FILE=false
CONSOLE_LOG_LEVEL=warn
CHECK_BALANCE=false
APP_TITLE=Hermes
SCARF_ANALYTICS=false
